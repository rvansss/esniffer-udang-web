generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionState {
  UNKNOWN
  ONLINE
  OFFLINE
}

enum ConnectionEvidence {
  NONE
  LIVE_STATUS
  LIVE_TELEMETRY
  RETAINED_SNAPSHOT
  LWT
}

enum SensorQuality {
  OK
  SENSOR_ERROR
  OUT_OF_RANGE
  MISSING
}

enum MeasurementTimeQuality {
  SYNCED
  RECONSTRUCTED
  UNKNOWN
}

enum IngestionSource {
  MQTT
  PROMETHEUS_IMPORT
}

enum UserRole {
  VIEWER
  ADMIN
}

// Dataset collection (PRD §5.4). Enum UPPER_CASE mengikuti konvensi repo;
// konversi ke lowercase CSV (market/farm, room_temp/cold) di lapisan API/export.
enum CollectionSourceType {
  MARKET
  FARM
  SUPERMARKET
}

enum InitialCondition {
  DEAD
  ALIVE
}

enum ShrimpType {
  VANAME
  WINDU
}

enum StorageCondition {
  ROOM_TEMP
  COLD
}

// Revisi putaran 2 butir 1: membedakan kelompok dingin dalam chamber vs
// langsung di kulkas. Hanya bermakna untuk storage_condition = COLD; grup
// ruang memakai default CHAMBER tanpa perubahan perilaku. CHECK lintas-field
// (plain_fridge_no_chamber, cold_chamber_required) dijaga di migrasi SQL.
enum ColdStorageMode {
  CHAMBER
  PLAIN_FRIDGE
}

enum VisualCheck {
  NORMAL
  MELANOSIS
  DAMAGED
  MIXED_SPECIES
}

enum SessionStatus {
  OPEN
  COMPLETE
  INCOMPLETE
  LOCKED
}

model Chamber {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(32)
  name        String             @db.VarChar(100)
  description String?            @db.VarChar(500)
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments DeviceAssignment[]
  readings    SensorReading[]
  sampleGroups SampleGroup[]
  sessions     MeasurementSession[]

  @@map("chambers")
}

model Device {
  id                    String                @id @default(uuid()) @db.Uuid
  mqttDeviceId          String                @unique @map("mqtt_device_id") @db.VarChar(64)
  name                  String                @db.VarChar(100)
  isActive              Boolean               @default(true) @map("is_active")
  connectionState       ConnectionState       @default(UNKNOWN) @map("connection_state")
  connectionEvidence    ConnectionEvidence    @default(NONE) @map("connection_evidence")
  currentBootId         String?               @map("current_boot_id") @db.Uuid
  currentSessionId      String?               @map("current_session_id") @db.Uuid
  currentConnectionSeq  BigInt?               @map("current_connection_seq") @db.BigInt
  currentStatusSequence BigInt?               @map("current_status_sequence") @db.BigInt
  lastSeenAt            DateTime?             @map("last_seen_at") @db.Timestamptz(3)
  lastStatusEventAt     DateTime?             @map("last_status_event_at") @db.Timestamptz(3)
  lastStatusProcessedAt DateTime?             @map("last_status_processed_at") @db.Timestamptz(3)
  firmwareVersion       String?               @map("firmware_version") @db.VarChar(64)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments           DeviceAssignment[]
  timeReferences        DeviceTimeReference[]
  readings              SensorReading[]
  sessions              MeasurementSession[]

  @@map("devices")
}

model DeviceAssignment {
  id          String          @id @default(uuid()) @db.Uuid
  deviceId    String          @map("device_id") @db.Uuid
  chamberId   String          @map("chamber_id") @db.Uuid
  activeFrom  DateTime        @map("active_from") @db.Timestamptz(3)
  activeUntil DateTime?       @map("active_until") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  chamber     Chamber         @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  readings    SensorReading[]

  @@index([deviceId, activeFrom(sort: Desc)])
  @@index([chamberId, activeFrom(sort: Desc)])
  @@map("device_assignments")
}

model DeviceTimeReference {
  id             String          @id @default(uuid()) @db.Uuid
  deviceId       String          @map("device_id") @db.Uuid
  bootId         String          @map("boot_id") @db.Uuid
  referenceKey   String          @map("reference_key") @db.VarChar(128)
  anchorUtc      DateTime        @map("anchor_utc") @db.Timestamptz(3)
  anchorUptimeMs BigInt          @map("anchor_uptime_ms") @db.BigInt
  uncertaintyMs  Int             @map("uncertainty_ms")
  source         String          @db.VarChar(32)
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  device         Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  readings       SensorReading[]

  @@unique([deviceId, bootId, referenceKey])
  @@index([deviceId, bootId, anchorUptimeMs])
  @@map("device_time_references")
}

model SensorReading {
  id                     String                 @id @default(uuid()) @db.Uuid
  deviceId               String                 @map("device_id") @db.Uuid
  chamberId              String?                @map("chamber_id") @db.Uuid
  assignmentId           String?                @map("assignment_id") @db.Uuid
  messageId              String                 @map("message_id") @db.VarChar(128)
  payloadSha256          String                 @map("payload_sha256") @db.Char(64)
  bootId                 String                 @map("boot_id") @db.Uuid
  sequence               BigInt                 @db.BigInt
  sampleUptimeMs         BigInt?                @map("sample_uptime_ms") @db.BigInt
  measuredAt             DateTime?              @map("measured_at") @db.Timestamptz(3)
  receivedAt             DateTime               @default(now()) @map("received_at") @db.Timestamptz(3)
  measurementTimeQuality MeasurementTimeQuality @map("measurement_time_quality")
  timeReferenceId        String?                @map("time_reference_id") @db.Uuid
  timeUncertaintyMs      Int?                   @map("time_uncertainty_ms")
  historySequence        BigInt?                @unique @map("history_sequence") @db.BigInt
  ingestionSource        IngestionSource        @default(MQTT) @map("ingestion_source")
  temperatureC           Decimal?               @map("temperature_c") @db.Decimal(7, 3)
  temperatureQuality     SensorQuality          @map("temperature_quality")
  humidityPercent        Decimal?               @map("humidity_percent") @db.Decimal(6, 3)
  humidityQuality        SensorQuality          @map("humidity_quality")
  mq137Raw               Decimal?               @map("mq137_raw") @db.Decimal(14, 3)
  mq137Quality           SensorQuality          @map("mq137_quality")
  mq136Raw               Decimal?               @map("mq136_raw") @db.Decimal(14, 3)
  mq136Quality           SensorQuality          @map("mq136_quality")
  mq4Raw                 Decimal?               @map("mq4_raw") @db.Decimal(14, 3)
  mq4Quality             SensorQuality          @map("mq4_quality")
  rawPayload             Json                   @map("raw_payload") @db.JsonB
  sessionId              String?                @map("session_id") @db.Uuid
  batchId                String?                @map("batch_id") @db.VarChar(16)
  timepointCode          String?                @map("timepoint_code") @db.VarChar(8)
  isBaseline             Boolean?               @map("is_baseline")
  device                 Device                 @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  chamber                Chamber?               @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  assignment             DeviceAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  timeReference          DeviceTimeReference?   @relation(fields: [timeReferenceId], references: [id], onDelete: Restrict)
  session                MeasurementSession?    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  batch                  CollectionBatch?       @relation(fields: [batchId], references: [batchId], onDelete: Restrict)

  @@unique([deviceId, messageId])
  @@index([chamberId, measuredAt(sort: Desc), receivedAt(sort: Desc), historySequence(sort: Desc)])
  @@index([deviceId, measuredAt(sort: Desc), receivedAt(sort: Desc), historySequence(sort: Desc)])
  @@index([assignmentId, measuredAt(sort: Desc)])
  @@index([bootId, sampleUptimeMs])
  @@index([sessionId, measuredAt(sort: Desc)])
  @@index([batchId, timepointCode])
  @@map("sensor_readings")
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(254)
  passwordHash     String        @map("password_hash") @db.VarChar(255)
  role             UserRole      @default(VIEWER)
  isActive         Boolean       @default(true) @map("is_active")
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?     @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions         AuthSession[]
  collectionBatches CollectionBatch[] @relation("BatchOperator")
  notifications    Notification[]
  batchDrafts      BatchDraft[]

  @@map("users")
}

/**
 * Satu akun dipakai bergiliran oleh beberapa operator di beberapa perangkat
 * (HP, laptop). Karena itu identitas perangkat dicatat di sini: tanpa itu,
 * daftar "perangkat aktif" tidak bisa dibedakan dan tidak ada cara mencabut
 * sesi satu perangkat yang hilang tanpa mengeluarkan semua orang.
 *
 * `operator_name` adalah operator yang sedang memegang perangkat itu, dikirim
 * klien lewat header X-Operator. Ini bukan identitas kriptografis (akun tetap
 * satu); nilainya juga dicatat di setiap baris dataset yang dibuat.
 */
model AuthSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  deviceId     String?   @map("device_id") @db.VarChar(64)
  deviceLabel  String?   @map("device_label") @db.VarChar(80)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  lastIp       String?   @map("last_ip") @db.VarChar(64)
  /** Operator yang terakhir terlihat memakai perangkat ini. */
  operatorName String?   @map("operator_name") @db.VarChar(80)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, deviceId])
  @@map("auth_sessions")
}

model CollectionBatch {
  id                String               @id @default(uuid()) @db.Uuid
  batchId           String               @unique @map("batch_id") @db.VarChar(16)
  // Keberangkatan dari lab menuju pasar (revisi wizard). Nullable: baris lama
  // tidak diisi nilai karangan; kewajiban isi ditegakkan di API untuk batch baru.
  departedAtUtc     DateTime?            @map("departed_at_utc") @db.Timestamptz(3)
  procuredAtUtc     DateTime             @map("procured_at_utc") @db.Timestamptz(3)
  // Teks bebas sesuai revisi (bukan dropdown); non-empty dijaga CHECK.
  marketSource      String               @map("market_source") @db.VarChar(100)
  sourceType        CollectionSourceType @default(MARKET) @map("source_type")
  shrimpType        ShrimpType?          @map("shrimp_type")
  shrimpCount       Int                  @map("shrimp_count")
  sizeGrade         Int                  @map("size_grade")
  shrimpLengthCm    Decimal?             @map("shrimp_length_cm") @db.Decimal(5, 2)
  totalWeightG      Decimal              @map("total_weight_g") @db.Decimal(8, 2)
  initialCondition  InitialCondition     @map("initial_condition")
  initialTempC      Decimal              @map("initial_temp_c") @db.Decimal(5, 2)
  arrivedAtUtc      DateTime             @map("arrived_at_utc") @db.Timestamptz(3)
  // Revisi wizard: tiga titik pengukuran cool box - saat berangkat (departure),
  // di pasar (market), dan di lab. Batas domain -10..10 °C (lihat migration
  // collection_batches_cooler_range); kontrak JSON lama (coolerTempMinC/MaxC)
  // tetap dilayani sebagai alias deprecated di serializeBatch.
  coolerTempDepartureC Decimal?           @map("cooler_temp_departure_c") @db.Decimal(5, 2)
  coolerTempMarketC Decimal              @map("cooler_temp_market_c") @db.Decimal(5, 2)
  coolerTempLabC    Decimal              @map("cooler_temp_lab_c") @db.Decimal(5, 2)
  iceToShrimpRatio  String               @default("2:1") @map("ice_to_shrimp_ratio") @db.VarChar(8)
  rejectionNotes    String?              @map("rejection_notes") @db.VarChar(500)
  operatorId        String               @map("operator_id") @db.Uuid
  // Akun dipakai bersama beberapa operator, jadi identitas pencatat disimpan
  // sebagai label bebas di samping operatorId (yang selalu akun bersama itu).
  operatorLabel     String?              @map("operator_label") @db.VarChar(80)
  createdByDevice   String?              @map("created_by_device") @db.VarChar(80)
  lockedAt          DateTime?            @map("locked_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  operator          User                 @relation("BatchOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  sampleGroups      SampleGroup[]
  sessions          MeasurementSession[]
  readings          SensorReading[]
  photos            BatchPhoto[]
  notifications     Notification[]
  calibrations      GroupCalibration[]
  drafts            BatchDraft[]

  @@map("collection_batches")
}

model BatchPhoto {
  id        String          @id @default(uuid()) @db.Uuid
  batchId   String          @map("batch_id") @db.VarChar(16)
  // Revisi putaran 2 butir 2: foto bisa menempel ke grup tertentu
  // (foto dokumentasi per grup di step pengelompokan). NULL = foto batch
  // (pengadaan). ON DELETE SET NULL: bila grup hilang, foto tetap milik batch.
  groupId   String?         @map("group_id") @db.VarChar(24)
  // Revisi tabel riwayat dinamis: foto per tahap menempel ke satu sesi
  // observasi. NULL = foto batch/grup biasa. ON DELETE SET NULL: bila sesi
  // hilang, foto tetap milik batch dan tampil sebagai foto bebas.
  sessionId String?              @map("session_id") @db.VarChar(32)
  url       String          @db.VarChar(500)
  caption   String          @db.VarChar(140)
  sortOrder Int             @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  batch     CollectionBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  group     SampleGroup?    @relation(fields: [groupId], references: [groupId], onDelete: SetNull)
  session   MeasurementSession? @relation(fields: [sessionId], references: [sessionId], onDelete: SetNull)

  @@unique([batchId, url])
  @@index([batchId, sortOrder])
  @@index([batchId, groupId])
  @@index([batchId, sessionId])
  @@map("batch_photos")
}

model SampleGroup {
  id                String           @id @default(uuid()) @db.Uuid
  groupId           String           @unique @map("group_id") @db.VarChar(24)
  batchId           String           @map("batch_id") @db.VarChar(16)
  chamberId         String?          @map("chamber_id") @db.Uuid
  storageCondition  StorageCondition @map("storage_condition")
  coldStorageMode   ColdStorageMode  @default(CHAMBER) @map("cold_storage_mode")
  targetTempC       Decimal          @map("target_temp_c") @db.Decimal(5, 2)
  labTempC          Decimal?         @map("lab_temp_c") @db.Decimal(5, 2)
  visualCheck       VisualCheck      @map("visual_check")
  labWeightBeforeG  Decimal?             @map("lab_weight_before_g") @db.Decimal(8, 2)
  labWeightAfterG   Decimal?             @map("lab_weight_after_g") @db.Decimal(8, 2)
  sampleShrimpCount Int              @map("sample_shrimp_count")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  batch             CollectionBatch  @relation(fields: [batchId], references: [batchId], onDelete: Restrict)
  chamber           Chamber?         @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  sessions          MeasurementSession[]
  photos            BatchPhoto[]
  calibration       GroupCalibration?

  @@unique([batchId, storageCondition])
  @@map("sample_groups")
}

model MeasurementSession {
  id            String        @id @default(uuid()) @db.Uuid
  sessionId     String        @unique @map("session_id") @db.VarChar(32)
  groupId       String        @map("group_id") @db.VarChar(24)
  batchId       String        @map("batch_id") @db.VarChar(16)
  chamberId     String?       @map("chamber_id") @db.Uuid
  deviceId      String?       @map("device_id") @db.Uuid
  timepointCode String        @map("timepoint_code") @db.VarChar(8)
  elapsedHours  Int           @map("elapsed_hours")
  startedAtUtc  DateTime      @map("started_at_utc") @db.Timestamptz(3)
  // Batas window akuisisi; dipakai backfill Fase 6 agar worker tidak diubah.
  endedAtUtc    DateTime?     @map("ended_at_utc") @db.Timestamptz(3)
  durationSeconds Int?        @map("duration_seconds")
  baselineMq137 Decimal?      @map("baseline_mq137") @db.Decimal(14, 3)
  baselineMq136 Decimal?      @map("baseline_mq136") @db.Decimal(14, 3)
  baselineMq4   Decimal?      @map("baseline_mq4") @db.Decimal(14, 3)
  warmupDone    Boolean       @default(false) @map("warmup_done")
  cleaningDone  Boolean       @default(false) @map("cleaning_done")
  // Jejak kalibrasi dua tahap yang menjadi prasyarat sesi live. Disimpan di
  // sesi (bukan hanya di grup) supaya setiap tahap H0/H6/… membawa bukti
  // prasyaratnya sendiri saat diekspor atau diaudit.
  calibrationCompletedAtUtc DateTime? @map("calibration_completed_at_utc") @db.Timestamptz(3)
  calibrationVersion        Int?      @map("calibration_version")
  /** Label operator perangkat yang membuat / menyelesaikan tahap. */
  createdByOperator   String? @map("created_by_operator") @db.VarChar(80)
  createdByDevice     String? @map("created_by_device") @db.VarChar(80)
  completedByOperator String? @map("completed_by_operator") @db.VarChar(80)
  completedByDevice   String? @map("completed_by_device") @db.VarChar(80)
  // Revisi tabel riwayat dinamis: data observasi per tahap. Modal pra-sesi
  // yang tadinya menimpa kolom grup kini menyimpan salinan per sesi, jadi
  // setiap tahap (H0, H6, …) punya suhu/berat sendiri di tabel riwayat.
  // Nullable: baris sebelum revisi tidak direkayasa; kolom grup dipertahankan
  // untuk data awal wizard langkah 3.
  shrimpTempC   Decimal?      @map("shrimp_temp_c") @db.Decimal(5, 2)
  shrimpWeightG Decimal?      @map("shrimp_weight_g") @db.Decimal(8, 2)
  status        SessionStatus @default(OPEN) @map("status")
  lockedAt      DateTime?     @map("locked_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  group         SampleGroup     @relation(fields: [groupId], references: [groupId], onDelete: Restrict)
  batch         CollectionBatch @relation(fields: [batchId], references: [batchId], onDelete: Restrict)
  chamber       Chamber?        @relation(fields: [chamberId], references: [id], onDelete: Restrict)
  device        Device?         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  readings      SensorReading[]
  notifications Notification[]
  photos        BatchPhoto[]

  @@unique([groupId, timepointCode])
  @@index([chamberId, startedAtUtc])
  @@map("measurement_sessions")
}

model HistorySequenceWatermark {
  id              Int    @id @default(1)
  currentSequence BigInt @default(0) @map("current_sequence") @db.BigInt

  @@map("history_sequence_watermark")
}

/**
 * Agregat nasib pesan ingest per alat per jam. Worker mencatat tiap pesan
 * (tersimpan, duplikat, ditolak beserta alasannya, dibuang antre penuh)
 * sehingga endpoint kesehatan bisa menjawab "data saya ke mana?" tanpa
 * membaca log. Baris dihitung naik (count), bukan satu baris per pesan.
 */
model IngestOutcome {
  id           String   @id @default(uuid()) @db.Uuid
  mqttDeviceId String   @map("mqtt_device_id") @db.VarChar(64)
  outcome      String   @db.VarChar(48)
  windowStart  DateTime @map("window_start") @db.Timestamptz(3)
  count        Int      @default(1)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([mqttDeviceId, outcome, windowStart])
  @@index([windowStart])
  @@map("ingest_outcomes")
}

/**
 * Revisi pembimbing putaran 2 butir 9: lonceng notifikasi di header.
 * Idempotensi (satu notifikasi stabil per sesi) ditegakkan di DB lewat
 * @@unique([sessionId, kind]): Postgres memperbolehkan duplikat ketika
 * session_id NULL, jadi notifikasi tanpa sesi tetap boleh berulang —
 * tanpa partial index manual dan tanpa cek aplikasi yang bisa balapan.
 */
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  batchId   String?  @map("batch_id") @db.VarChar(16)
  sessionId String?  @map("session_id") @db.VarChar(32)
  // Nilai terkendali disimpan sebagai teks agar menambah jenis notifikasi
  // tidak perlu migrasi enum (pola market_source).
  kind      String   @db.VarChar(40)
  message   String   @db.VarChar(200)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch     CollectionBatch?  @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  session   MeasurementSession? @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@unique([sessionId, kind])
  @@index([userId, createdAt])
  @@map("notifications")
}

/**
 * Kalibrasi dua tahap milik satu grup (chamber tertutup → chamber dibuka).
 *
 * Sebelum Fase 0 state ini hidup di localStorage, sehingga kalibrasi yang
 * dimulai di HP tidak terlihat di laptop dan hitungannya harus diulang.
 * Sekarang yang disimpan adalah WAKTU MULAI ABSOLUT tiap langkah (bukan sisa
 * detik), jadi semua perangkat menghitung sisa yang sama dari jam server.
 *
 * `steps` berisi array `{ key, durationMins, startedAtUtc }`; validasinya di
 * lapisan aplikasi (lib/calibration.ts), bukan constraint DB, karena bentuk
 * JSON ini bisa berkembang tanpa migrasi baru.
 */
model GroupCalibration {
  id                String    @id @default(uuid()) @db.Uuid
  batchId           String    @map("batch_id") @db.VarChar(16)
  groupId           String    @unique @map("group_id") @db.VarChar(24)
  steps             Json      @db.JsonB
  // Diisi server saat kedua langkah benar-benar habis (bukan diklaim klien).
  completedAtUtc    DateTime? @map("completed_at_utc") @db.Timestamptz(3)
  version           Int       @default(1)
  updatedByUserId   String?   @map("updated_by_user_id") @db.Uuid
  updatedByOperator String?   @map("updated_by_operator") @db.VarChar(80)
  updatedByDevice   String?   @map("updated_by_device") @db.VarChar(80)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  batch             CollectionBatch @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  group             SampleGroup     @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@index([batchId])
  @@map("group_calibrations")
}

/**
 * Draf wizard batch baru di server (Fase 0). Sebelumnya draf hanya ada di
 * localStorage dengan satu kunci global, sehingga isian yang dimulai di HP
 * tidak bisa dilanjutkan di laptop — dan dua operator di satu browser saling
 * menimpa draf.
 *
 * `version` adalah kunci optimistic concurrency: klien mengirim versi yang
 * dibacanya, server menolak (409) bila sudah berubah, jadi draf tidak pernah
 * tertimpa diam-diam dari perangkat lain.
 */
model BatchDraft {
  id               String   @id @default(uuid()) @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  /** Label operator pemilik draf; akun bersama tidak membedakan orang. */
  ownerOperator    String   @map("owner_operator") @db.VarChar(80)
  ownerDeviceId    String?  @map("owner_device_id") @db.VarChar(64)
  ownerDeviceLabel String?  @map("owner_device_label") @db.VarChar(80)
  label            String   @default("") @db.VarChar(120)
  step             Int      @default(0)
  payload          Json     @db.JsonB
  /** OPEN | CONSUMED | DISCARDED (draft kedaluwarsa tidak dihapus, hanya disaring). */
  status           String   @default("OPEN") @db.VarChar(16)
  version          Int      @default(1)
  consumedBatchId  String?  @map("consumed_batch_id") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consumedBatch    CollectionBatch? @relation(fields: [consumedBatchId], references: [batchId], onDelete: SetNull)

  @@index([ownerId, status, updatedAt])
  @@map("batch_drafts")
}
