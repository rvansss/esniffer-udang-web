# Copy to deploy/.env.production. This file contains only non-secret settings.
COMPOSE_PROJECT_NAME=esniffer
APP_IMAGE=esniffer-udang-web
APP_TAG=local
DASHBOARD_HOST=dashboard.example.com
APP_BASE_URL=https://dashboard.example.com
APP_ORIGIN_ALLOWLIST=

POSTGRES_DB=esniffer
POSTGRES_USER=esniffer_owner
POSTGRES_RUNTIME_USER=esniffer_app
DATABASE_POOL_MAX=5

MQTT_BROKER_HOST=mqtt.example.com
MQTT_URL=mqtts://mqtt.example.com:8883
MQTT_CLIENT_ID=esniffer-ingest-v1
MQTT_USERNAME=worker
MQTT_CA_CERT_PATH=./secrets/mqtt/ca.crt
MQTT_SERVER_CERT_PATH=./secrets/mqtt/server.crt
MQTT_SERVER_KEY_PATH=./secrets/mqtt/server.key
MQTT_PASSWORDS_PATH=./secrets/mqtt/passwords.txt
MQTT_WORKER_PASSWORD_PATH=./secrets/mqtt/worker_password.txt
MQTT_HEALTH_PASSWORD_PATH=./secrets/mqtt/healthcheck_password.txt
MQTT_RECONNECT_MIN_MS=1000
MQTT_RECONNECT_MAX_MS=30000
WORKER_CONCURRENCY=5
WORKER_MAX_QUEUE=500

POSTGRES_PASSWORD_PATH=./secrets/postgres_password.txt
POSTGRES_RUNTIME_PASSWORD_PATH=./secrets/postgres_runtime_password.txt
AUTH_SECRET_PATH=./secrets/auth_secret.txt
CURSOR_SIGNING_SECRET_PATH=./secrets/cursor_signing_secret.txt
HTTPS_CERT_PATH=./secrets/https/fullchain.pem
HTTPS_KEY_PATH=./secrets/https/privkey.pem

LOG_LEVEL=INFO
