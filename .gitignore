# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation
diki/
docs/
!docs/
docs/*
!docs/esniffer/
docs/esniffer/*
!docs/esniffer/*.md

# mosquitto secrets and persistence data
docker/mosquitto/config/passwords.txt
docker/mosquitto/data/
docker/mosquitto/certs/
docker/mosquitto/secrets/

# production deployment material (templates remain tracked)
deploy/.env.production
deploy/secrets/
deploy/backups/

# dataset collection uploads (local multi-file batch photos, PRD §3.1)
public/uploads/*
!public/uploads/.gitkeep
