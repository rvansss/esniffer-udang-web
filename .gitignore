# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentation
diki/
docs/

# generated knowledge-graph output (regenerable via graphify; see graphify-out/manifest.json)
graphify-out/

# mosquitto secrets and persistence data
docker/mosquitto/config/passwords.txt
docker/mosquitto/data/
docker/mosquitto/certs/
docker/mosquitto/secrets/

# firmware sketch berisi kredensial WiFi dan MQTT alat (jangan di-commit)
/esniffer_esp32_nextion/

# production deployment material (templates remain tracked)
deploy/.env.production
deploy/secrets/
deploy/backups/

# dataset collection uploads (local multi-file batch photos, PRD §3.1)
public/uploads/*
!public/uploads/.gitkeep

# workbook/CSV hasil analisis lokal untuk stakeholder (jangan di-commit)
/exports/

# tooling AI agent lokal (skill yang di-vendor per mesin + konfigurasi MCP
# personal berisi path absolut dan referensi token) — bukan bagian aplikasi
/.agents/
/opencode.json
