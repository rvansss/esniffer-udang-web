# ==============================================================================
# e-Sniffer Udang Environment Configuration (Example)
# Dokumen acuan: docs/esniffer/03-technical-design.md
# JANGAN cantumkan kredensial produksi pada file ini.
# ==============================================================================

# Database PostgreSQL. Gunakan role runtime dengan hak minimum; jangan publish
# port PostgreSQL ke internet.
DATABASE_URL="postgresql://<runtime-user>:<runtime-password>@postgres:5432/esniffer?schema=public"
DATABASE_POOL_MAX="5"

# Mosquitto MQTT Broker. Production WAJIB mqtts:// dan CA trust eksplisit.
MQTT_URL="mqtts://mosquitto:8883"
MQTT_CLIENT_ID="esniffer-ingest-v1"
MQTT_USERNAME="<worker-username>"
MQTT_PASSWORD="<worker-password>"
MQTT_CA_FILE="/run/secrets/mqtt-ca.crt"
# Isi keduanya hanya bila deployment memilih mutual TLS.
MQTT_CLIENT_CERT_FILE=""
MQTT_CLIENT_KEY_FILE=""
WORKER_CONCURRENCY="5"
WORKER_MAX_QUEUE="500"

# Web Application & Auth Security (Fase 4)
AUTH_SECRET="<random-secret-at-least-32-bytes>"
CURSOR_SIGNING_SECRET="<different-random-secret-at-least-32-bytes>"
APP_BASE_URL="https://<dashboard-host>"
# Optional comma-separated additional trusted HTTPS origins.
APP_ORIGIN_ALLOWLIST=""

# Logging & Observability
LOG_LEVEL="INFO" # DEBUG | INFO | WARN | ERROR
